/**
    A deliberately small FM synth that demonstrates a complete, GitHub-loadable
    Cmajor project. It uses Cmajor's MPE converter, voice allocator, note helpers,
    and envelope library.
*/

graph SimpleFMSynth [[ main ]]
{
    input event std::midi::Message midiIn;
    input event float carrierRatio [[ name: "Carrier ratio", min: 0.25, max: 4.0, init: 1.0, step: 0.25 ]];
    input event float modulatorRatio [[ name: "Modulator ratio", min: 0.25, max: 8.0, init: 2.0, step: 0.25 ]];
    input event float modulationIndex [[ name: "FM index", min: 0.0, max: 12.0, init: 2.5, step: 0.05 ]];
    input event float level [[ name: "Level", min: 0.0, max: 0.2, init: 0.08, step: 0.005 ]];
    output stream float out;

    let voiceCount = 8;

    node
    {
        voices = FMVoice[voiceCount];
        voiceAllocator = std::voices::VoiceAllocator (voiceCount);
    }

    connection
    {
        midiIn -> std::midi::MPEConverter -> voiceAllocator;
        voiceAllocator.voiceEventOut -> voices.eventIn;

        carrierRatio -> voices.carrierRatioIn;
        modulatorRatio -> voices.modulatorRatioIn;
        modulationIndex -> voices.modulationIndexIn;
        level -> voices.levelIn;
        voices -> out;
    }
}

graph FMVoice
{
    input event (std::notes::NoteOn, std::notes::NoteOff) eventIn;
    input event float carrierRatioIn;
    input event float modulatorRatioIn;
    input event float modulationIndexIn;
    input event float levelIn;
    output stream float out;

    node
    {
        noteToFrequency = NoteToFrequency;
        envelope = std::envelopes::FixedASR (0.008f, 0.18f);
        oscillator = PhaseModOscillator;
    }

    connection
    {
        eventIn -> noteToFrequency -> oscillator.frequencyIn;
        eventIn -> envelope.eventIn;
        carrierRatioIn -> oscillator.carrierRatioIn;
        modulatorRatioIn -> oscillator.modulatorRatioIn;
        modulationIndexIn -> oscillator.modulationIndexIn;
        levelIn -> oscillator.levelIn;
        (envelope.gainOut * oscillator.out) -> out;
    }
}

processor NoteToFrequency
{
    input event std::notes::NoteOn eventIn;
    output event float32 frequencyOut;

    event eventIn (std::notes::NoteOn e)
    {
        frequencyOut <- std::notes::noteToFrequency (e.pitch);
    }
}

processor PhaseModOscillator
{
    input event float frequencyIn;
    input event float carrierRatioIn;
    input event float modulatorRatioIn;
    input event float modulationIndexIn;
    input event float levelIn;
    output stream float out;

    event frequencyIn (float value)       { baseFrequency = value; }
    event carrierRatioIn (float value)    { carrierRatio = value; }
    event modulatorRatioIn (float value)  { modulatorRatio = value; }
    event modulationIndexIn (float value) { modulationIndex = value; }
    event levelIn (float value)           { level = value; }

    void main()
    {
        baseFrequency = 440.0f;
        carrierRatio = 1.0f;
        modulatorRatio = 2.0f;
        modulationIndex = 2.5f;
        level = 0.08f;

        loop
        {
            let carrierDelta = float (baseFrequency * carrierRatio * processor.period * twoPi);
            let modulatorDelta = float (baseFrequency * modulatorRatio * processor.period * twoPi);
            out <- level * sin (carrierPhase + modulationIndex * sin (modulatorPhase));
            carrierPhase = addModulo2Pi (carrierPhase, carrierDelta);
            modulatorPhase = addModulo2Pi (modulatorPhase, modulatorDelta);
            advance();
        }
    }

    float baseFrequency, carrierRatio, modulatorRatio, modulationIndex, level;
    float carrierPhase, modulatorPhase;
}
